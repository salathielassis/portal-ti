// ============================================================================
// Portal TI - Controle de Ativos (ITAM)
// Prisma Schema — PostgreSQL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// RBAC / IDENTIDADE
// ----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  FINANCEIRO
  SUPORTE
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          UserRole @default(SUPORTE)
  department    Department? @relation(fields: [departmentId], references: [id])
  departmentId  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  allocationsMade   AssetAllocation[] @relation("AllocatedBy")
  movementsLogged   AssetMovement[]   @relation("MovementBy")
  reconciliationsDone Reconciliation[] @relation("ReconciledBy")

  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  costCenterCode String? @unique
  users     User[]
  allocations AssetAllocation[]
  invoiceAllocations InvoiceCostAllocation[]
  createdAt DateTime @default(now())

  @@map("departments")
}

// ----------------------------------------------------------------------------
// CLIENTES E OBRAS/FILIAIS
//
// Um Client é o grupo empresarial (ex.: "DOISA"), identificado pela raiz do
// CNPJ (8 primeiros dígitos, compartilhada entre matriz e todas as filiais).
// Cada local físico — a própria matriz/sede inclusive — é um Site, com CNPJ
// completo próprio. É em Site que o ativo é fisicamente alocado, e é o campo
// "CLASSIFICAÇÃO" do extrato da locadora (ex.: "EQUIP - BARRO ALTO GO") que
// vira o nome/centro de custo de um Site.
// ----------------------------------------------------------------------------

model Client {
  id        String   @id @default(uuid())
  name      String                       // ex.: "DOISA"
  cnpjRoot  String   @unique             // 8 primeiros dígitos do CNPJ (raiz), ex.: "03092799"
  sites     Site[]
  createdAt DateTime @default(now())

  @@map("clients")
}

model Site {
  id                 String   @id @default(uuid())
  client             Client   @relation(fields: [clientId], references: [id])
  clientId           String
  name               String                    // ex.: "Barro Alto GO"
  costCenterLabel    String?                   // campo "CLASSIFICAÇÃO" do extrato, ex.: "EQUIP - BARRO ALTO GO"
  cnpj               String   @unique          // CNPJ completo desta filial/obra (ou da matriz)
  isHeadquarters     Boolean  @default(false)  // true para a matriz/sede

  addressStreet      String?
  addressNumber      String?
  addressComplement  String?
  addressDistrict    String?
  addressCity        String?
  addressState       String?
  addressZip         String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?

  allocations        AssetAllocation[]
  contracts          Contract[]
  createdAt          DateTime @default(now())

  @@map("sites")
}

// ----------------------------------------------------------------------------
// MÓDULO A — GESTÃO DE ATIVOS
// ----------------------------------------------------------------------------

enum AssetType {
  NOTEBOOK
  IMPRESSORA
  MONITOR
  PERIFERICO
  OUTRO
}

enum AssetOwnership {
  PROPRIO
  LOCADO
}

enum AssetStatus {
  EM_USO
  ESTOQUE
  MANUTENCAO
  DESCARTADO
  EM_TRANSITO
}

// Tabela de preços de referência por "tipo" de equipamento (ex.: "Notebook
// Core i5" → R$ 220,00). Usada para (a) o financeiro consultar o valor
// esperado por tipo e (b) o importador de extrato de locação avisar quando
// o valor cobrado por um item destoa da referência.
//
// A classificação de um Asset num tier é automática, por palavra-chave, a
// partir da descrição do equipamento (ver `classifyEquipmentTier` em
// `lease-import`/`assets`) — não é um enum fixo no código porque o usuário
// pode cadastrar novos tipos pela tela sem precisar de deploy. `keywords` é
// uma lista onde cada item é obrigatório (E lógico); dentro de um item,
// "A|B|C" funciona como OU (ex.: ["CORE ULTRA 7", "GTX|RTX|V-"] casa
// "CORE ULTRA 7" E (contém "GTX" OU "RTX" OU "V-")). `sortOrder` define a
// ordem de avaliação — regras mais específicas (ex.: a variante "Gamer")
// devem ter `sortOrder` menor para serem checadas antes da genérica.
model EquipmentPriceTier {
  id             String   @id @default(uuid())
  label          String   @unique // ex.: "Notebook Core i5"
  keywords       String[] // ex.: ["CORE I5"]
  referenceValue Decimal  @db.Decimal(12, 2)
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assets Asset[]

  @@map("equipment_price_tiers")
}

model Asset {
  id               String         @id @default(uuid())
  assetTag         String         @unique // Nº de patrimônio
  serialNumber     String         @unique
  type             AssetType
  ownership        AssetOwnership
  brand            String
  model            String
  specs            Json?          // CPU, RAM, SSD, etc. (schema flexível)
  status           AssetStatus    @default(ESTOQUE)

  // Tipo classificado automaticamente por palavra-chave (ver EquipmentPriceTier) — null = não classificado
  priceTier        EquipmentPriceTier? @relation(fields: [priceTierId], references: [id])
  priceTierId      String?

  // Se locado, vínculo com contrato/fornecedor
  contract         Contract?      @relation(fields: [contractId], references: [id])
  contractId       String?
  supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  supplierId       String?

  purchaseValue    Decimal?       @db.Decimal(12, 2) // se próprio
  purchaseDate     DateTime?
  warrantyEndDate  DateTime?

  // Se locado: valor de locação individual deste equipamento (varia por
  // modelo dentro do mesmo contrato — não é sempre igual a
  // contract.monthlyValuePerAsset) e data em que foi instalado no site.
  monthlyValue     Decimal?       @db.Decimal(12, 2)
  installationDate DateTime?

  allocations      AssetAllocation[]
  movements        AssetMovement[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([ownership])
  @@map("assets")
}

// Alocação atual e histórica (quem está usando o ativo agora / no passado)
model AssetAllocation {
  id            String     @id @default(uuid())
  asset         Asset      @relation(fields: [assetId], references: [id])
  assetId       String

  assignedToName String    // nome do colaborador/responsável (pode não ter User no sistema)
  department    Department? @relation(fields: [departmentId], references: [id])
  departmentId  String?
  site          Site?      @relation(fields: [siteId], references: [id])
  siteId        String?    // obra/filial do cliente onde o ativo está instalado
  clientName    String?    // texto livre legado — preferir `site` quando disponível

  deliveryDate  DateTime
  returnDate    DateTime?  // null = alocação ativa
  isActive      Boolean    @default(true)

  allocatedBy   User?      @relation("AllocatedBy", fields: [allocatedById], references: [id])
  allocatedById String?

  notes         String?
  createdAt     DateTime   @default(now())

  @@index([assetId, isActive])
  @@map("asset_allocations")
}

enum MovementType {
  ENTREGA
  DEVOLUCAO
  TRANSFERENCIA
  MANUTENCAO_ENTRADA
  MANUTENCAO_SAIDA
  DESCARTE
}

// Log de rastreabilidade (trilha de auditoria completa do ativo)
model AssetMovement {
  id          String       @id @default(uuid())
  asset       Asset        @relation(fields: [assetId], references: [id])
  assetId     String
  type        MovementType
  fromStatus  AssetStatus?
  toStatus    AssetStatus?
  description String?
  loggedBy    User?        @relation("MovementBy", fields: [loggedById], references: [id])
  loggedById  String?
  occurredAt  DateTime     @default(now())

  @@index([assetId])
  @@map("asset_movements")
}

// ----------------------------------------------------------------------------
// MÓDULO B — CONTRATOS E FORNECEDORES
// ----------------------------------------------------------------------------

model Supplier {
  id            String     @id @default(uuid())
  name          String
  cnpj          String     @unique
  slaHours      Int?       // SLA de atendimento em horas
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  assets        Asset[]
  contracts     Contract[]
  createdAt     DateTime   @default(now())

  @@map("suppliers")
}

enum ContractStatus {
  ATIVO
  ENCERRADO
  EM_RENOVACAO
  CANCELADO
}

model Contract {
  id                   String         @id @default(uuid())
  contractNumber       String         @unique
  supplier             Supplier       @relation(fields: [supplierId], references: [id])
  supplierId           String
  site                 Site?          @relation(fields: [siteId], references: [id])
  siteId               String?        // obra/filial do cliente coberta por este contrato
  status               ContractStatus @default(ATIVO)

  startDate            DateTime
  endDate               DateTime
  monthlyValuePerAsset Decimal        @db.Decimal(12, 2) // valor de referência — cada Asset pode ter monthlyValue próprio (preços variam por modelo)
  earlyTerminationFee  Decimal?       @db.Decimal(12, 2)
  annualReadjustIndex  String?        // ex: "IPCA", "IGP-M"
  annualReadjustPct    Decimal?       @db.Decimal(5, 2)

  assets               Asset[]
  invoices             Invoice[]
  alerts               ContractAlert[]

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([endDate])
  @@map("contracts")
}

enum AlertThreshold {
  D30
  D15
  D07
}

// Alertas de vencimento gerados por job agendado
model ContractAlert {
  id          String         @id @default(uuid())
  contract    Contract       @relation(fields: [contractId], references: [id])
  contractId  String
  threshold   AlertThreshold
  triggeredAt DateTime       @default(now())
  acknowledged Boolean       @default(false)

  @@unique([contractId, threshold])
  @@map("contract_alerts")
}

// ----------------------------------------------------------------------------
// MÓDULO C — FINANCEIRO E CONCILIAÇÃO
// ----------------------------------------------------------------------------

enum InvoiceStatus {
  PENDENTE
  CONCILIADA
  PAGA
  VENCIDA
  CONTESTADA
}

// Contas a pagar (faturas de locação)
model Invoice {
  id            String        @id @default(uuid())
  contract      Contract      @relation(fields: [contractId], references: [id])
  contractId    String
  referenceMonth DateTime     // competência (mês/ano da fatura)
  dueDate       DateTime
  grossValue    Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(PENDENTE)

  costAllocations InvoiceCostAllocation[]
  reconciliationMatches ReconciliationMatch[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Garante idempotência na importação automática de extratos de locação:
  // reimportar o mesmo extrato/mês para o mesmo contrato atualiza a fatura
  // existente em vez de duplicá-la.
  @@unique([contractId, referenceMonth])
  @@index([status])
  @@index([referenceMonth])
  @@map("invoices")
}

// Rateio de custo por departamento/cliente (uma fatura pode ser dividida)
model InvoiceCostAllocation {
  id            String     @id @default(uuid())
  invoice       Invoice    @relation(fields: [invoiceId], references: [id])
  invoiceId     String
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  String
  percentage    Decimal    @db.Decimal(5, 2)
  value         Decimal    @db.Decimal(12, 2)

  @@map("invoice_cost_allocations")
}

enum ReconciliationStatus {
  PROCESSANDO
  CONCLUIDA
  ERRO
}

// Um upload de extrato bancário em PDF gera uma "sessão" de conciliação
model Reconciliation {
  id            String               @id @default(uuid())
  referenceMonth DateTime
  fileName      String
  fileUrl       String               // caminho no storage (S3/blob)
  status        ReconciliationStatus @default(PROCESSANDO)
  totalTransactions Int              @default(0)
  matchedCount  Int                  @default(0)

  reconciledBy  User?                @relation("ReconciledBy", fields: [reconciledById], references: [id])
  reconciledById String?

  transactions  BankTransaction[]
  matches       ReconciliationMatch[]

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@map("reconciliations")
}

// Cada linha extraída do PDF do extrato bancário
model BankTransaction {
  id               String         @id @default(uuid())
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id])
  reconciliationId String
  transactionDate  DateTime
  description      String
  rawText          String         // linha bruta extraída do PDF (auditoria)
  amount           Decimal        @db.Decimal(12, 2) // saídas = negativo
  matched          Boolean        @default(false)

  match            ReconciliationMatch?

  @@index([reconciliationId])
  @@map("bank_transactions")
}

enum MatchType {
  AUTOMATICO
  SUGERIDO
  MANUAL
}

enum MatchStatus {
  PENDENTE_REVISAO
  CONFIRMADO
  REJEITADO
}

// O "match" entre uma transação bancária e uma fatura cadastrada
model ReconciliationMatch {
  id               String          @id @default(uuid())
  reconciliation   Reconciliation  @relation(fields: [reconciliationId], references: [id])
  reconciliationId String
  bankTransaction  BankTransaction @relation(fields: [bankTransactionId], references: [id])
  bankTransactionId String         @unique
  invoice          Invoice         @relation(fields: [invoiceId], references: [id])
  invoiceId        String

  matchType        MatchType
  matchStatus      MatchStatus     @default(PENDENTE_REVISAO)
  confidenceScore  Decimal         @db.Decimal(5, 2) // 0-100, calculado pelo algoritmo
  valueDelta       Decimal         @db.Decimal(12, 2) // diferença entre valor pago e valor da fatura

  createdAt        DateTime        @default(now())

  @@map("reconciliation_matches")
}
