# RECONSTRUÍDO a partir de `systemctl cat` parcial (VM 10.0.0.8, snapshot 2026-09-10).
# Só as linhas abaixo foram confirmadas na sessão:
#     User=ti
#     WorkingDirectory=/home/ti/apps/portal-ti/backend
#     ExecStart=/usr/bin/node dist/main.js
# O restante ([Unit]/[Install]/Restart/Environment) é um modelo típico —
# CONFIRME o arquivo real com:  systemctl cat portal-backend.service

[Unit]
Description=Portal TI Backend
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ti
WorkingDirectory=/home/ti/apps/portal-ti/backend
ExecStart=/usr/bin/node dist/main.js
EnvironmentFile=/home/ti/apps/portal-ti/backend/.env
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
